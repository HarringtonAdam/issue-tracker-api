# Ignore our Python virtual environment
.venv/

# Ignore Python-generated cache files
__pycache__/
*.pyc
.pytest_cache/

# Ignore environment variable files
.env

# Ignore VS Code-specific project settings
.vscode/

# Ignore local SQLite databases and their sidecar files
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Ignore backups
*.db.bak
